<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta content="IE=Edge" http-equiv="X-UA-Compatible">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"/>
  <title>海技士クイズ</title>
  <base href="/">

  <!-- ★ HTML レンダラーを強制（CSSフォントを確実に効かせる） -->
  <script>
    window.flutterConfiguration = { renderer: "html" };
  </script>

  <!-- 日本語フォントを先読み（Google Fonts） -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700&display=swap" rel="stylesheet">

  <!-- ページ全体を日本語系フォントに -->
  <style id="jp-font-patch">
    html, body, #flutter_host_element, #flt-glass-pane {
      font-family: 'Noto Sans JP','Yu Gothic UI','Yu Gothic','Meiryo','Hiragino Sans','Noto Sans CJK JP','Noto Sans',sans-serif;
    }
  </style>
</head>
<body>
  <!-- Flutter 起動スクリプト（必ず最後の方で、defer でOK） -->
  <script src="flutter_bootstrap.js" defer></script>
</body>
</html>
