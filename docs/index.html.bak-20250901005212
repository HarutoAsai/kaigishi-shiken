<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta content="IE=Edge" http-equiv="X-UA-Compatible">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"/>
  <title>海技士クイズ</title>
  <base href="/">

  <!-- 日本語フォント先読み -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700&display=swap" rel="stylesheet">

  <!-- 全体のフォントを日本語系に固定 -->
  <style id="jp-font-patch">
  :root, html, body, #flutter_host_element,
  flt-glass-pane, .flt-glass-pane, .flt-scene, .flt-semantics,
  .flt-paragraph, .flt-span, *,
  /* 一部ブラウザのSVGテキスト用 */
  svg, text, tspan {
    font-family: "Noto Sans JP","Yu Gothic UI","Yu Gothic","Meiryo","Hiragino Sans","Noto Sans CJK JP","Noto Sans",sans-serif !important;
  }
</style>

  <!-- レンダラーは HTML を既定に（このキーは initializeEngine に渡す） -->
  <script>window.flutterConfiguration = { renderer: "html" };</script>
<meta http-equiv="Content-Language" content="ja">
</head>
<body>
  <div id="boot-hint">起動中…（初回は少し時間がかかるよ）</div>

  <!-- 公式ローダー -->
  <script src="flutter.js" defer></script>
  <script>
    // 明示的にエンジン初期化→ runApp を呼ぶ
    window.addEventListener('load', function() {
      console.log('[boot] start loader');
      const cfg = window.flutterConfiguration || {};
      // 失敗時も原因がわかるように try/catch
      try {
        _flutter.loader.loadEntrypoint({
          onEntrypointLoaded: function(engineInitializer) {
            console.log('[boot] entrypoint loaded');
            engineInitializer.initializeEngine(cfg).then(function(appRunner) {
              console.log('[boot] engine initialized');
              appRunner.runApp();
              console.log('[boot] runApp called');
              window.addEventListener('flutter-first-frame', function() {
                const h = document.getElementById('boot-hint'); if (h) h.remove();
                console.log('[boot] first-frame rendered');
              });
            });
          }
        });
      } catch (e) {
        console.error('[boot] failed:', e);
        const h = document.getElementById('boot-hint');
        if (h) h.textContent = '起動失敗：Console のエラーを教えてね';
      }
    });
  </script>
</body>
</html>

